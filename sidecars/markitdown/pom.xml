<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.xyz</groupId>
		<artifactId>xyz-mcp-hub</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>
	<artifactId>markitdown-sidecar</artifactId>
	<packaging>pom</packaging>
	<name>xyz-mcp-hub sidecar: markitdown</name>
	<description>markitdown-mcp 容器化封装（ContainerMcp protocol=mcp）：mvn package/install 用 docker buildx 构建并装入本地 docker。镜像名单一事实源 = 根聚合 pom 的 ${mcp.markitdown.*} 属性（ADR-0012 / #31）</description>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>build-docker-image</id>
						<phase>package</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<!-- 在模块目录（Dockerfile 所在目录）以 buildx 构建并载入本地 docker -->
							<executable>docker</executable>
							<arguments>
								<argument>buildx</argument>
								<argument>build</argument>
								<argument>--load</argument>
								<argument>--tag</argument>
								<argument>${mcp.markitdown.image}</argument>
								<argument>.</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
